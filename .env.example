# Copy this file to .env and fill in your own values. Never commit .env.

# Required — see README.md "Setup & Installation" for how to obtain these.
TOKEN=your-discord-bot-token
CLIENT_ID=your-discord-application-client-id
MONGO=mongodb+srv://user:password@cluster.mongodb.net/musicbot?retryWrites=true&w=majority

# Optional — enables the custom emoji auto-upload feature. Omit to use
# built-in Unicode emoji instead.
EMOJIS_GUILD_ID=

# Optional — Lavalink connection overrides. Defaults already match a local
# Lavalink server started with the application.yml in this repo, so you
# normally don't need to set any of these. See LAVALINK_SETUP.md.
# LAVALINK_NAME=main
# LAVALINK_HOST=localhost
# LAVALINK_PORT=2333
# LAVALINK_PASSWORD=youshallnotpass
# LAVALINK_SECURE=false
